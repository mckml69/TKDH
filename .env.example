# Copy this file to .env and adjust as needed. Vite only exposes variables
# prefixed with VITE_ to the browser — see https://vitejs.dev/guide/env-and-mode

# "local"  = no backend at all, everything stored in this browser's localStorage.
#            Good for a first look at the UI. Data is NOT shared between devices
#            or team members, and is lost if the browser's storage is cleared.
# "api"    = talk to the reference server in /server (or your own backend that
#            implements the same contract — see server/README.md).
VITE_STORAGE_MODE=local

# Only used when VITE_STORAGE_MODE=api. Base URL of the backend's API.
# Leave this UNSET (or blank) when the backend serves the built frontend itself
# (see server/index.js — it serves ../dist and defaults to the same origin) —
# apiAdapter.js already defaults to the relative "/api", which is correct for
# that same-origin, single-deployed-service setup. Only set an absolute URL
# here for local dev against a separately-running server on another port, e.g.
# http://localhost:4000/api.
VITE_API_BASE_URL=http://localhost:4000/api

# This same codebase gets deployed once per venue. Set the name of THIS venue
# so "Hotel only" / "Whole building" scope labels (Contractors, Certificates)
# read correctly. Defaults to "Hotel" if unset.
VITE_VENUE_NAME=Hotel

# General Manager-only sidebar link to switch to the other venue's deployment,
# opened in a new tab. Leave VITE_PUB_URL unset until that deployment actually
# exists — the link simply doesn't render until it's configured. Once set,
# VITE_PUB_VENUE_NAME controls the link's label (defaults to "TKDH Pub").
# VITE_PUB_URL=https://tkdh-pub.onrender.com
# VITE_PUB_VENUE_NAME=TKDH Pub
