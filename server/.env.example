# Copy this file to server/.env and adjust as needed.

# Port the reference Express server listens on.
PORT=4000

# Path to the SQLite database file. Defaults to server/data.sqlite if unset.
DATABASE_PATH=./data.sqlite

# The exact origin of the frontend that's allowed to make credentialed (cookie-carrying)
# requests to this server. Only matters for local dev, where the frontend runs on its
# own Vite dev server (:5173) separate from this API (:4000) — a wildcard CORS origin
# cannot be combined with credentials, so it has to be explicit. In production, where
# this server serves the built frontend itself (see index.js), everything is same-origin
# and CORS doesn't come into play at all for real traffic.
CORS_ORIGIN=http://localhost:5173

# Set to "true" once this server is served over HTTPS (production — e.g. Render sets this
# up automatically). This makes the session cookie require TLS. Leave "false" for local
# http://localhost development — browsers won't send a Secure cookie back over plain http,
# so login would silently appear to fail if this were true in dev.
COOKIE_SECURE=false

# Set to "production" when deployed. Currently only affects a startup log line, but keep
# it accurate — hosts like Render set this automatically.
NODE_ENV=development

# --- Not used yet, but present so the shape is obvious for the future relational migration ---
# See README.md "Next steps" before deploying this server anywhere public.
# DATABASE_URL=postgres://user:password@host:5432/compliance_ledger

# --- Optional: cross-venue sharing (this same codebase deployed once per venue) ---
# Both unset by default — /api/shared/pull and /api/venue-pull just no-op (503 /
# { available: false }) until a second venue actually exists. Set BOTH, and set
# SHARED_SYNC_SECRET to the SAME value on both venues' servers, to turn it on.
# OTHER_VENUE_URL is this server's base URL for the OTHER venue, e.g. from the hotel's
# server this is the pub's URL, and vice versa — NOT the same as the frontend's
# VITE_PUB_URL (that one just drives the sidebar switcher link and is fine to be public;
# this one is used server-to-server and never reaches the browser).
# SHARED_SYNC_SECRET=
# OTHER_VENUE_URL=https://tkdh-pub.onrender.com

# --- Optional: Cloudflare R2 (S3-compatible) attachment storage ---
# All four must be set together or none of them are used. If unset, attachments
# (photos, voice notes, files) are stored as base64 directly in the database,
# exactly like before — fine for local dev, not recommended for production at
# any real scale. See r2.js and README.md "Attachments / object storage".
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=compliance-ledger-attachments
